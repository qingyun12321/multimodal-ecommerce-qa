--model /workspace/models/Qwen/Qwen3-VL-8B-Instruct
--model_type qwen3_vl
--template qwen3_vl
--tuner_type lora
--dataset data/training/sft/generated/mimo_multiturn/train.ms_swift.jsonl
--val_dataset data/training/sft/generated/mimo_multiturn/val.ms_swift.jsonl
--torch_dtype bfloat16
--attn_impl sdpa
--target_modules all-linear
--lora_rank 16
--lora_alpha 32
--lora_dropout 0.05
--max_length 4096
--per_device_train_batch_size 1
--per_device_eval_batch_size 1
--gradient_accumulation_steps 16
--learning_rate 1e-4
--num_train_epochs 2
--warmup_ratio 0.05
--save_steps 100
--eval_steps 100
--logging_steps 10
--eval_strategy steps
--save_strategy steps
--output_dir /workspace/checkpoints/qwen3-vl-8b-tool-call-sft-v2/main
--logging_dir /workspace/runs/qwen3-vl-8b-tool-call-sft-v2/main
--report_to tensorboard
--dataset_num_proc 1
--load_from_cache_file true
--gradient_checkpointing true
--add_version false
