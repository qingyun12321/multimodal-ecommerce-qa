--model /workspace/models/Qwen/Qwen3-VL-8B-Instruct
--model_type qwen3_vl
--template qwen3_vl
--tuner_type lora
--dataset /workspace/data/ecom-qa-tool-call-sft-v2/smoke_train.ms_swift.jsonl
--val_dataset /workspace/data/ecom-qa-tool-call-sft-v2/smoke_val.ms_swift.jsonl
--torch_dtype bfloat16
--attn_impl sdpa
--target_modules all-linear
--lora_rank 8
--lora_alpha 32
--lora_dropout 0.05
--max_length 2048
--per_device_train_batch_size 1
--per_device_eval_batch_size 1
--gradient_accumulation_steps 4
--learning_rate 1e-4
--max_steps 10
--warmup_ratio 0.05
--save_steps 10
--eval_steps 10
--logging_steps 1
--eval_strategy steps
--save_strategy steps
--output_dir /workspace/checkpoints/qwen3-vl-8b-tool-call-sft-v2/smoke
--logging_dir /workspace/runs/qwen3-vl-8b-tool-call-sft-v2/smoke
--report_to tensorboard
--dataset_num_proc 1
--load_from_cache_file false
--gradient_checkpointing true
--add_version false
